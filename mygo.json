{
  "name": "Kyokai",
  "identifier": "com.yuanzhe.kyokai",
  "version": "0.6.10",
  "copyright": "Copyright (C) 2026 YuanZhe",
  "main": "./cmd/kyokai",
  "out": "build",
  "i18n": {
    "dir": "locales",
    "source": "en"
  },
  "description": "AI Computer Use across devices",
  "updates": {
    "publicKey": "hxYzzr97hrfpwdw1aJBeJeiHpHBWZNtFE98WOi7JjmY=",
    "github": "YuanZhe-99/Kyokai",
    "changelog": "doc/en-us/version-history.md"
  },
  "macos": {
    "minimumSystemVersion": "14.0",
    "entitlements": "packaging/macos/app.entitlements",
    "helperEntitlements": {
      "bin/kyokai-svc": "packaging/macos/engine.entitlements",
      "bin/Kyokai Helper.app": "packaging/macos/engine.entitlements"
    },
    "infoPlist": {
      "NSLocalNetworkUsageDescription": "Kyokai connects directly to your other devices on this network.",
      "NSCameraUsageDescription": "Kyokai shares the picture of the NanoKVM USB capture card you choose with the devices you let use it.",
      "NSMicrophoneUsageDescription": "Kyokai shares the sound of the input you choose with the devices that control this Mac."
    }
  },
  "linux": {
    "maintainer": "YuanZhe <yuanzhe1999@outlook.com>",
    "comment": "AI Computer Use across devices",
    "categories": [
      "Network",
      "RemoteAccess"
    ],
    "depends": [
      "libayatana-appindicator3-1",
      "libpipewire-0.3-0t64",
      "libva2",
      "libva-drm2",
      "libavcodec62 | libavcodec61 | libavcodec60"
    ],
    "webview": false,
    "command": "kyokai"
  }
}
